! sedov3d_grav_part.nml — Mera test fixture: AMR hydro + SELF-GRAVITY + TRACER PARTICLES
!
! Same blast as sedov3d_amr.nml (RAMSES 2026.05 tests/hydro/sedov3d), with three additions so the
! run also exercises Mera's gravity and particle readers in one output:
!     poisson=.true.   -> writes grav_*.out, readable with getgravity (:ax,:ay,:az,:epot)
!     pic=.true.       -> the particle machinery
!     tracer=.true.    + &TRACER_PARAMS with tracer_feed_fmt='inplace'
!
! WHY TRACERS. RAMSES's own particle namelists (static.nml, p-pointmass3.nml) need an external
! particle IC file — static.nml points at an absolute path on someone else's cluster — so they
! cannot be regenerated by a third party. Monte-Carlo tracer particles are created IN PLACE from
! the gas, so the fixture stays self-contained: a namelist and nothing else.
!
! ORACLES (exact, resolution independent):
!   * tracer particles are neither created nor destroyed -> the particle COUNT is identical in
!     every snapshot
!   * their total mass is conserved to round-off
!   * every particle stays inside the box (periodic wrapping, no escapees)
!   * gravity: with a periodic box RAMSES subtracts the mean density, so the ambient acceleration
!     is ~0 by symmetry and only the blast contributes — assert finiteness and that |a| is
!     largest where the shell is, not an analytic profile.
!
! Inherits the two traps documented in sedov3d_amr.nml: the explosion is at the ORIGIN, and
! distances must use MINIMUM-IMAGE under periodic boundaries.
!
! NOTE: nparttot MUST be set in &AMR_PARAMS whenever pic/tracer are on. Without it RAMSES aborts
! on every rank with "npartmax should be greater than 1 got 0" before writing any output.
!
! MEASURED (RAMSES 2026.05, 8 ranks): 7 outputs, 75 MB, 2 s. Mera reads all three data types:
!   getgravity  -> 6469 cells, columns (:level,:cx,:cy,:cz,:epot,:ax,:ay,:az); |a|max ~ 0.143
!   getparticles-> 124,990 tracers, columns (:level,:x,:y,:z,:id,:family,:tag,:vx,:vy,:vz,
!                  :mass,:birth); header is the modern "Family" format, all gas_tracer
!   ORACLE 1  particle count identical in all 7 snapshots            -> true
!   ORACLE 2  total tracer mass max/min                              -> 1.000000000000000
!   ORACLE 3  particles outside the box                              -> 0
!
! Run:  mpirun -np 8 <build>/bin/ramses3d sedov3d_grav_part.nml > run.log 2>&1

&RUN_PARAMS
hydro=.true.
poisson=.true.
pic=.true.
tracer=.true.
ncontrol=1
nrestart=0
nremap=0
nsubcycle=10*2
verbose=.false.
/

&AMR_PARAMS
levelmin=4
levelmax=7
ngridtot=40000
nparttot=200000
nexpand=0
boxlen=0.5
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='point'
x_center=0.5,0.0
y_center=0.5,0.0
z_center=0.5,0.0
length_x=10.0,1.0
length_y=10.0,1.0
length_z=10.0,1.0
exp_region=10.0,10.0
d_region=1.0,0.0
u_region=0.0,0.0
v_region=0.0,0.0
w_region=0.0,0.0
p_region=1e-5,0.4
/

&OUTPUT_PARAMS
noutput=6
tout=1.0d-3,2.0d-3,3.5d-3,5.5d-3,7.5d-3,9.91d-3
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
scheme='muscl'
slope_type=8
riemann='hll'
/

&REFINE_PARAMS
interpol_var=2
interpol_type=1
err_grad_p=0.1
r_refine=0.125,0.0625,0.03125
x_refine=0.0625,0.0625
y_refine=0.0625,0.0625
z_refine=0.0625,0.0625
exp_refine=10,10.,10.
/

&TRACER_PARAMS
MC_tracer=.true.
tracer_feed_fmt='inplace'
tracer_mass=1e-6
/
