&RUN_PARAMS
hydro=.true.
nremap=10
ncontrol=10
nsubcycle=10*1
/
&AMR_PARAMS
levelmin=3
levelmax=9
ngridmax=20000
nexpand=1
boxlen=0.5
/
&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='point'
x_center=0.5,0.0
length_x=1.0,1.0
d_region=1.0,0.0
u_region=0.0,0.0
p_region=1e-5,0.4
/
&OUTPUT_PARAMS
noutput=30
tout=0.00667,0.01334,0.02001,0.02668,0.03335,0.04002,0.04669,0.05336,0.06003,0.0667,0.07337,0.08004,0.08671,0.09338,0.10005,0.10672,0.11339,0.12006,0.12673,0.1334,0.14007,0.14674,0.15341,0.16008,0.16675,0.17342,0.18009,0.18676,0.19343,0.2001
/
&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=2
riemann='hllc'
/
&REFINE_PARAMS
err_grad_p=0.1
interpol_var=0
