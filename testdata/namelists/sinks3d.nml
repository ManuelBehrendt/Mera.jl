! sinks3d.nml — Mera test fixture: a RAMSES run carrying a SINK-PARTICLE catalogue
!
! Derived from RAMSES 2026.05 tests/sink/stellar-spawn. That test is a validated configuration but
! an impractical fixture: levelmin=6 with foutput=1 writes an output every step and produced
! 4.3 GB / 17 outputs here. This variant keeps the sink physics and shrinks everything around it:
!   levelmin/levelmax 6/8 -> 5/6      (the base grid is the cost driver: 64^3 -> 32^3)
!   nlevelmax_sink   7 -> 6           (must not exceed levelmax)
!   ngridmax     350000 -> 150000     (matches the smaller grid)
!   foutput           1 -> 20         (a handful of outputs, not one per step)
!   nstepmax added                    (bounds the run)
!   nstellarmax raised                (the coarser grid spawns more stellar objects per step;
!                                     without this RAMSES aborts with "Not enough space for new
!                                     stellar objects")
!
! WHAT IT IS FOR. Sinks are the one RAMSES data product Mera had no reader for until getsinks;
! this fixture is what lets the suite check DETECTION in a real output tree — that getinfo finds
! sink_NNNNN.csv and sets info.sinks — which the data-free tests in test/77_sinks_tests.jl cannot
! cover. It also backs the sinks documentation notebook.
!
! THE SINK COMES FROM ic_sink, not from accretion: RAMSES reads it at t=0, so every output has a
! sink and the fixture does not depend on one forming during the run. Generate it with
!     printf '4079,0,0,0,0,0,0,0,0,0,4079,4079\n' > ic_sink
! (mass, position, velocity, spin, ... in code units — one line per initial sink).
!
! Run:  mpirun -np 8 <build>/bin/ramses3d sinks3d.nml > run.log 2>&1

&RUN_PARAMS
nstepmax=40
hydro=.true.
rt=.false.
nrestart=0
nremap=10
poisson=.true.
pic=.true.
sink=.true.
stellar=.true.
nsubcycle=1
verbose=.false.
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=125
y_center=125
z_center=125
length_x=250
length_y=250
length_z=250
exp_region=10.0
d_region=1d1		   	  ! 10 hydrogen atoms per cc
p_region=3300.1987634209013
/

&AMR_PARAMS
levelmin=5
levelmax=6
ngridmax=150000
npartmax=2200
nexpand=4
boxlen=250. ! pc
/

&OUTPUT_PARAMS
foutput=20
tend=0.25
/

&HYDRO_PARAMS
gamma=1.666666667
courant_factor=0.8
riemann='hllc'
slope_type=1
pressure_fix=.true.
beta_fix=0.5
/

&COOLING_PARAMS
cooling=.false.
metal=.false.
z_ave=1.0
/

&UNITS_PARAMS
units_density = 1.66d-24 ! 1 H/cc
units_time    = 3.004683525921981d15 !95.21470899675022 Myr
units_length  = 3.08567758128200d18 ! 1 pc
/

&REFINE_PARAMS
jeans_refine=8
interpol_type=0
interpol_var=1
sink_refine=.true.
/

&POISSON_PARAMS
gravity_type=0
/

&SINK_PARAMS
nlevelmax_sink=6
create_sinks=.false.
nsinkmax=1
mass_sink_seed=1 ! in M_sun
accretion_scheme='bondi'
n_sink=1d2 ! ramses doens't like it if you don't set this
/

&STELLAR_PARAMS
sn_feedback_sink=.false.
nstellarmax=200
stellar_msink_th=200. ! threshold for stellar obj creation
! IMF
imf_index=-2.35
imf_low=8
imf_high=120
/
