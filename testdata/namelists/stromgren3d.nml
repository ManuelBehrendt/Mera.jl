! stromgren3d.nml — Mera test fixture: RAMSES-RT Stromgren sphere (Iliev et al. Test 1)
!
! Derived from RAMSES 2026.05 `namelist/stromgren.nml`. Changes, all deliberate:
!   levelmin/levelmax 7 -> 5   (32^3 instead of 128^3). MEASURED: 64^3 costs ~80 MB PER
!                              OUTPUT (RT stores 3 photon groups x 4 vars on every cell) and
!                              did not reach t=500 Myr in 10 min on 8 ranks. 32^3 gives ~11
!                              cells across r_S, enough to measure the I-front to ~10 %.
!   ngridmax 300000 -> 50000   (matches the smaller grid)
!   delta_tout/tend -> explicit tout list (6 snapshots instead of 50)
!   static_gas=.true.          ADDED. Without it the photo-heated gas expands hydrodynamically and
!                              the front runs PAST the static Stromgren radius: measured r/r_S
!                              went 0.91, 0.96, 0.99, 1.08, 1.30, 1.70 over the six times. That is
!                              correct physics (a D-type front) but it is NOT the closed-form test.
!                              Iliev Test 1 is static; static_gas freezes the hydrodynamics while
!                              RT still ionises, so the analytic law applies at every snapshot.
! Physics, units, RT groups, cross-sections and boundaries are untouched.
!
! ANALYTIC ORACLE. With Ndot = 5e48 photons/s (summed over the 3 groups), n_H = 1e-3 cm^-3 and
! case-B recombination alpha_B ~ 2.59e-13 cm^3/s at 1e4 K:
!     r_S    = (3 Ndot / (4 pi alpha_B n_H^2))^(1/3)  ~  5.4 kpc
!     t_rec  = 1/(alpha_B n_H)                        ~  122 Myr
!     r(t)   = r_S (1 - exp(-t/t_rec))^(1/3)
! The six output times (code time unit = 1 Myr) sample that curve at r/r_S ~ 0.43, 0.60, 0.73,
! 0.86, 0.96, 0.99 — the rise AND the asymptote, so a test can check the whole approach law
! rather than one radius.
!
! THE SOURCE IS AT THE ORIGIN (rt_src_*_center = 0), a box corner, with reflecting boundaries on
! the -x/-y/-z faces: this evolves one octant of a sphere. Measure radius from [0,0,0]. Unlike
! the Sedov fixture the boundaries here are NOT periodic (see &BOUNDARY_PARAMS), so plain
! Euclidean distance is correct.
!
! MEASURED (RAMSES 2026.05 RT=1 NIONS=3 NGROUPS=3, 8 ranks): 7 outputs, 119 MB, 84 s.
! Ionised-gas <T> is 29,000-36,000 K, NOT 1e4 K, so alpha_B must be rescaled per snapshot as
! alpha_B ~ 2.59e-13 (T/1e4)^-0.7 before comparing; using the 1e4 K value overstates the
! recombination rate and understates r_S by ~30 %.
! With that correction, r_measured/r_analytic = 0.901, 0.921, 0.931, 0.928, 0.925, 0.911 over the
! six times — CONSTANT to +-1.6 % across a 50x span in t. The ~8 % systematic offset is one cell
! width (0.47 kpc on 32^3) at the front, i.e. resolution, not a modelling error. A test should
! therefore assert the CONSTANCY of the ratio (the shape of the law) plus a loose absolute band.
!
! Measure the radius from the IONISED VOLUME, not the outermost ionised cell:
!     V_ion = sum(volume[xHII > 0.5]);  one octant  =>  r = (6 V_ion / pi)^(1/3)
! Through gethydro the ionisation fractions arrive as UNNAMED passive scalars — with NIONS=3 and
! pure hydrogen (X=1, Y=0), :scalar_00 is xHII.
!
! Run:  mpirun -np 8 <build>/bin/ramses3d_rt stromgren3d.nml > run.log 2>&1

&RUN_PARAMS
hydro=.true.
rt=.true.
static_gas=.true.
nrestart=0
nremap=0
nsubcycle=10*1
verbose=.false.
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=7.5
y_center=7.5
z_center=7.5
length_x=100.0
length_y=100.0
length_z=100.0
exp_region=10.0
d_region=1d-3		   	  ! 1e-3 hydrogen atoms per cc
p_region=8.69869d-10		  ! 100 K
var_region(1,1)=1e-6
/

&AMR_PARAMS
levelmin=5
levelmax=5
ngridmax=50000
nexpand=1
boxlen=15.			!  1 kpc
/

&OUTPUT_PARAMS
noutput=6
tout=10.,30.,60.,120.,250.,500.
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
scheme='muscl'
slope_type=2
riemann='hllc'
/

&COOLING_PARAMS
cooling=.true.
/

&UNITS_PARAMS
units_density=1.66d-24
units_time=3.1556926d13
units_length=3.08568025d21
/

&REFINE_PARAMS
err_grad_d=0.4
/

&RT_PARAMS
X=1d0
Y=0d0
rt_flux_scheme='glf'
rt_courant_factor=0.8
rt_c_fraction=0.01
rt_nsource=3
rt_source_type=3*'point'
rt_src_x_center=3*0.
rt_src_y_center=3*0.
rt_src_z_center=3*0.
rt_src_length_x=3*1.0
rt_src_length_y=3*1.0
rt_src_length_z=3*1.0
rt_src_group=1,2,3
rt_n_source=2.235d48,2.47d48,0.295d48 ! Total = 5d48
rt_u_source=3*0
rt_v_source=3*0
rt_w_source=3*0
rt_is_init_xion=.false.
/

&RT_GROUPS			! Blackbody at T=1d5 Kelvin
group_csn(1,:)= 3.00d-18, 0.,0.   ! pck 1-> HI, HeI, HeII
group_cse(1,:)= 2.78d-18, 0.,0.   ! pck 1-> HI, HeI, HeII
group_csn(2,:)= 5.69d-19, 0.,0.   ! pck 2-> HI, HeI, HeII
group_cse(2,:)= 5.04d-19, 0.,0.   ! pck 2-> HI, HeI, HeII
group_csn(3,:)= 7.89d-20, 0.,0.   ! pck 3-> HI, HeI, HeII
group_cse(3,:)= 7.46d-20, 0.,0.   ! pck 3-> HI, HeI, HeII
group_egy = 18.85, 35.079, 65.666
spec2group    = 1,2,3             ! HI, HeI, HeII -> pck
/

&BOUNDARY_PARAMS
nboundary=6
bound_type= 1, 2,  1,  2,  1,  2
ibound_min=-1, 1, -1, -1, -1, -1
ibound_max=-1, 1,  1,  1,  1,  1
jbound_min= 0, 0, -1,  1, -1, -1
jbound_max= 0, 0, -1,  1,  1,  1
kbound_min= 0, 0,  0,  0, -1,  1
kbound_max= 0, 0,  0,  0, -1,  1
/
